# Hostinger (Apache): faz as páginas do site (/produtos, /sobre, /produto/...) abrirem
# direto pelo link ou ao recarregar, entregando o index.html do React.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  # Arquivo que não existe (.js, .css, imagem, .txt, .json...) responde 404 em vez da página do site.
  # Sem isso, um arquivo faltando chega ao navegador como HTML (foi o que deixou o site em branco).
  RewriteCond %{REQUEST_URI} !\.(js|mjs|css|map|png|jpe?g|webp|avif|gif|svg|ico|woff2?|ttf|txt|xml|json|webmanifest)$ [NC]
  RewriteRule . /index.html [L]
</IfModule>

# Segurança: o navegador não deixa outros sites embutirem a loja, não "adivinha" tipos de arquivo,
# usa sempre HTTPS e não repassa o endereço completo da página para outros sites.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  # CSP: de onde o site pode carregar código, estilos, fontes, imagens e conexões. Barra script
  # injetado. Scripts só do próprio site; dados só do Supabase da Maré; imagens de qualquer https.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; media-src 'self' blob: https://tnhckvugdavdjfhlvtmq.supabase.co; connect-src 'self' https://tnhckvugdavdjfhlvtmq.supabase.co wss://tnhckvugdavdjfhlvtmq.supabase.co; frame-src 'none'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
</IfModule>

# Cache (visitas seguintes mais rápidas):
# - /assets: código, estilos e fontes com hash no nome (o nome muda a cada versão) → 1 ano, imutável.
# - index.html: sempre confere se há versão nova, para atualizações aparecerem na hora.
# - imagens: 30 dias.
<IfModule mod_headers.c>
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
