# Hostinger (Apache): faz as páginas do site (/produtos, /sobre, /produto/...) abrirem
# direto pelo link ou ao recarregar, entregando o index.html do React.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Segurança: o navegador não deixa outros sites embutirem a loja, não "adivinha" tipos de arquivo,
# usa sempre HTTPS e não repassa o endereço completo da página para outros sites.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  # CSP: de onde o site pode carregar código, estilos, fontes, imagens e conexões. Barra script
  # injetado. Scripts só do próprio site; dados só do Supabase da Maré; imagens de qualquer https.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https://tnhckvugdavdjfhlvtmq.supabase.co; connect-src 'self' https://tnhckvugdavdjfhlvtmq.supabase.co wss://tnhckvugdavdjfhlvtmq.supabase.co; frame-src 'none'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
</IfModule>

# Cache longo para imagens e arquivos com hash (carregamento mais rápido em visitas seguintes)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
